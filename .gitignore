# ---------------------------------------------------------------- generated data
# Rebuild with `bash scripts/gen_data.sh`; the four .h5 files are ~4.4 GB in total.
data/adr2d/
*.h5

# -------------------------------------------------------------- training outputs
# Per-run metrics (results/**/*.json, *.csv, *.yaml) and the five-seed checkpoints
# (results/**/best.pth, 1.2 MB each) are committed so the paper's numbers can be
# re-derived and every stated result is backed by a weight file.  Field dumps and
# run logs are regenerable and are not committed.
results/**/*.pt
results/**/*.ckpt
results/**/*.bin
results/**/*.npz
results/**/*.log
results/**/*.err
results/**/*.out
results/**/*.done
results/**/*.status
logs/

# written by fig/qa_check.py on every run
fig/qa-report.json

# ---------------------------------------------------------------------- python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -------------------------------------------------------------- editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
